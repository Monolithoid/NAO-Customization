# Plymouth script plugin. All coordinates adapt to the current screen.
Window.SetBackgroundTopColor(0.035, 0.055, 0.10);
Window.SetBackgroundBottomColor(0.07, 0.12, 0.20);

# Preload all frames; no video decoder or segmentation model is needed at boot.
for (i = 0; i < 20; i++) {
    number = i + 1;
    if (number < 10) name = "frames/frame-0" + number + ".png";
    else name = "frames/frame-" + number + ".png";
    frame = Image(name);
    frames[i] = frame.Scale(frame.GetWidth() * 2, frame.GetHeight() * 2);
}
mascot.image = frames[0];
mascot.sprite = Sprite(mascot.image);
mascot.sprite.SetZ(1);
time = 0;

prompt.sprite = Sprite();
prompt.sprite.SetZ(10);
message.sprite = Sprite();
message.sprite.SetZ(10);

fun center_text(sprite, text, y) {
    image = Image.Text(text, 0.9, 0.95, 1);
    sprite.SetImage(image);
    sprite.SetX(Window.GetWidth() / 2 - image.GetWidth() / 2);
    sprite.SetY(y);
}

fun refresh() {
    # Plymouth invokes the refresh callback at approximately 50 Hz.
    time += 0.02;
    index = Math.Int(time * 30) % 20;
    mascot.sprite.SetImage(frames[index]);
    mascot.sprite.SetX(Window.GetWidth() / 2 - mascot.image.GetWidth() / 2);
    mascot.sprite.SetY(Window.GetHeight() / 2 - mascot.image.GetHeight() / 2);
}
Plymouth.SetRefreshFunction(refresh);

# Keep boot messages and interactive prompts visible (e.g. disk unlocking).
fun display_message(text) {
    center_text(message.sprite, text, Window.GetHeight() * 0.85);
}
Plymouth.SetDisplayMessageFunction(display_message);

fun display_password(prompt, bullets) {
    text = prompt + " ";
    for (i = 0; i < bullets; i++) text += "*";
    center_text(prompt.sprite, text, Window.GetHeight() * 0.75);
}
Plymouth.SetDisplayPasswordFunction(display_password);

fun display_question(prompt, entry) {
    center_text(prompt.sprite, prompt + " " + entry, Window.GetHeight() * 0.75);
}
Plymouth.SetDisplayQuestionFunction(display_question);

fun display_normal() {
    prompt.sprite.SetImage(Image.Text("", 1, 1, 1));
}
Plymouth.SetDisplayNormalFunction(display_normal);
